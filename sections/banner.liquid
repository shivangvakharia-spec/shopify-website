<link rel="stylesheet" href="{{ 'banner-stylesheet.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>
  {{ 'banner-stylesheet.css' | asset_url | stylesheet_tag }}
</noscript>

{%- style -%}
  .banner-section-{{ section.id }} {
    --banner-bg: {{ section.settings.bg_color | default: '#004d40' }};
    --banner-color: {{ section.settings.text_color | default: '#ffffff' }};
    --banner-font-size: {{ section.settings.font_size | default: 13 }}px;
  }
{%- endstyle -%}

<div class="banner banner-section-{{ section.id }}" role="region" aria-label="Announcement">
  <div class="banner__container page-width">
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}" class="banner__link">
        <p class="banner__text">{{ section.settings.text }}</p>
      </a>
    {% else %}
      <p class="banner__text">{{ section.settings.text }}</p>
    {% endif %}
  </div>
</div>

<script src="{{ 'banner-javascript.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Banner",
  "class": "banner-parent",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "15% Off over ₹5000 Use Code WELLIEWOW"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#004d40"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Font Size",
      "default": 13
    }
  ],
  "presets": [
    {
      "name": "Banner"
    }
  ]
}
{% endschema %}