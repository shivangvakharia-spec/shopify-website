<link rel="stylesheet" href="{{ 'pdp-stylesheet.css' | asset_url }}" media="print" onload="this.media='all'">

<div class="pdp">

  {% if product.featured_image %}
    <div class="pdp_product_image">

      {{
        product.featured_image
        | image_url: width: 800
        | image_tag
      }}

    </div>
  {% endif %}


  <div class="pdp_product_details">

    {% for block in section.blocks %}

      {% case block.type %}

        {% when 'title' %}

		{% if block.settings.heading_size == 'h1' %}
			<h1
			class="pdp_product_title"
			{{ block.shopify_attributes }}
			>
			{{ product.title }}
			</h1>

		{% elsif block.settings.heading_size == 'h2' %}
			<h2
			class="pdp_product_title"
			{{ block.shopify_attributes }}
			>
			{{ product.title }}
			</h2>

		{% elsif block.settings.heading_size == 'h3' %}
			<h3
			class="pdp_product_title"
			{{ block.shopify_attributes }}
			>
			{{ product.title }}
			</h3>
		{% endif %}

        {% when 'price' %}

          <div
            class="pdp_product_price"
            {{ block.shopify_attributes }}
          >

            <span class="pdp_product_price--regular">
              {{ product.price | money }}
            </span>

            {% if product.compare_at_price > product.price %}
              <span class="pdp_product_price--compare">
                {{ product.compare_at_price | money }}
              </span>
            {% endif %}

          </div>

		{% when 'description' %}

		{% if block.settings.show_description %}
			<div
			class="pdp_product_description"
			{{ block.shopify_attributes }}
			>
			{{ product.description }}
			</div>
		{% endif %}

      {% endcase %}

    {% endfor %}


    {% form 'product', product %}

      <input
        type="hidden"
        name="id"
        value="{{ product.selected_or_first_available_variant.id }}"
      >

      <button
        type="submit"
        class="pdp_add_to_cart"
      >
        Add to cart
      </button>

    {% endform %}

  </div>

</div>


<script src="{{ 'pdp-javascript.js' | asset_url }}" defer></script>


{% schema %}
{
  "name": "PDP",
  "class": "pdp-parent",
  "blocks": [
    {
      "type": "title",
      "name": "Product Title",
	  "settings": [
		{
		"type": "select",
		"id": "heading_size",
		"label": "Heading size",
		"options": [
			{
			"value": "h1",
			"label": "Large"
			},
			{
			"value": "h2",
			"label": "Medium"
			},
			{
			"value": "h3",
			"label": "Small"
			}
		],
		"default": "h1"
		}
	]
    },
    {
      "type": "price",
      "name": "Product Price",
	  "settings": [
		{
			"type": "checkbox",
			"id": "show_description",
			"label": "Show description",
			"default": true
		}
	]
    },
    {
      "type": "description",
      "name": "Product Description"
    }
  ],
  "settings": [
	
  ],
  "presets": [
    {
      "name": "PDP",
      "blocks": [
        {
          "type": "title"
        },
        {
          "type": "price"
        },
        {
          "type": "description"
        }
      ]
    }
  ]
}
{% endschema %}